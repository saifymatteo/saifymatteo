{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saiful-mashuri",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "cache": {
    "enabled": true,
  },
  // Last-good CMS catalog copy (lib/projects/catalog_cache.ts). Free plan:
  // hard daily caps, no billing. Create once: npx wrangler kv namespace create CMS_CATALOG
  "kv_namespaces": [
    {
      "binding": "CMS_CATALOG",
      "id": "e73764415b644dc486968ce2558a0283",
      "remote": true,
    },
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "saifulmashuri.com",
      "custom_domain": true,
    },
    {
      "pattern": "www.saifulmashuri.com",
      "custom_domain": true,
    },
  ],
  "vars": {
    "TURNSTILE_HOSTNAMES": "saifulmashuri.com,www.saifulmashuri.com",
    // Public origin (not a secret); read at runtime. See docs/payload-cms.md.
    "PAYLOAD_CMS_URL": "https://cms.saifulmashuri.com",
  },
}
